{
  "workflow": ".github/workflows/ci.yml",
  "jobs": [
    {
      "id": "control-plane",
      "name": "Control-plane unit tests",
      "required_snippets": [
        "working-directory: services/ai_control_plane",
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97",
        "python-version: '3.14'",
        "python -m pip install .",
        "python -m unittest discover -s tests -v"
      ]
    },
    {
      "id": "contracts",
      "name": "Contract tests",
      "required_snippets": [
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97",
        "python-version: '3.14'",
        "python -m pip install './services/ai_control_plane[test]'",
        "python -m unittest discover -s tests/contract -v"
      ]
    },
    {
      "id": "lint",
      "name": "Python lint",
      "required_snippets": [
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97",
        "python-version: '3.14'",
        "python -m pip install ruff==0.14.10 mypy==2.3.0",
        "python -m pip install ./services/ai_control_plane",
        "ruff check --no-cache apps/ services/",
        "python -m mypy services/ai_control_plane/src"
      ]
    },
    {
      "id": "repository",
      "name": "Repository checks",
      "required_snippets": [
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97",
        "python-version: '3.14'",
        "scripts/run-quality-gates.sh",
        "scripts/dev.sh compose-config"
      ]
    },
    {
      "id": "aws-iac",
      "name": "AWS IaC validation (no credentials)",
      "required_snippets": [
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "TERRAFORM_VERSION: '1.13.5'",
        "TERRAFORM_SHA256: 0dbe3fcc268eb670801af6a6456799d1ae26e72e73797f6c6167e18aafd1fd9a",
        "python3 scripts/check-aws-iac.py",
        "terraform -chdir=infra/aws/terraform validate",
        "terraform -chdir=infra/aws/bootstrap validate",
        "python -m unittest discover -s tests/infra -v"
      ]
    },
    {
      "id": "docker-behavior",
      "name": "ERP Docker behavior and browser tests",
      "required_snippets": [
        "runs-on: ubuntu-24.04",
        "timeout-minutes: 60",
        "uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "scripts/ci-docker-gates.sh"
      ]
    }
  ],
  "forbidden_snippets": [
    "pull_request_target",
    "permissions: write-all",
    "contents: write",
    "secrets.",
    "docker compose up",
    "docker compose push",
    "gh release",
    "npm publish",
    "twine upload"
  ]
}
