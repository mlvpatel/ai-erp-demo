{
  "dependabot_file": ".github/dependabot.yml",
  "policy_doc": "docs/workflows/dependency-updates.md",
  "required_update_entries": [
    {
      "package_ecosystem": "github-actions",
      "directory": "/",
      "interval": "monthly",
      "labels": [
        "dependency",
        "ci"
      ],
      "open_pull_requests_limit": 3
    },
    {
      "package_ecosystem": "pip",
      "directory": "/services/ai_control_plane",
      "interval": "monthly",
      "labels": [
        "dependency",
        "ai-control-plane"
      ],
      "open_pull_requests_limit": 3
    },
    {
      "package_ecosystem": "pip",
      "directory": "/apps/ai_erp_core",
      "interval": "monthly",
      "labels": [
        "dependency",
        "erp-safety"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "pip",
      "directory": "/apps/ai_erp_service",
      "interval": "monthly",
      "labels": [
        "dependency",
        "erp-safety"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "docker",
      "directory": "/services/ai_control_plane",
      "interval": "monthly",
      "labels": [
        "dependency",
        "runtime"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "npm",
      "directory": "/tests/e2e",
      "interval": "monthly",
      "labels": [
        "dependency",
        "developer tooling"
      ],
      "open_pull_requests_limit": 2
    }
  ],
  "held_tool_pins": [
    {
      "tool": "ruff",
      "version": "0.14.10",
      "reason": "Held deliberately: the flake8-bandit (S) rules were enabled on this pin, and a version bump changes the default rule set in ways that are not separable from a select change afterwards. Confirm the new default rules before any bump.",
      "review_by": "2027-02-04"
    },
    {
      "tool": "mypy",
      "version": "2.3.0",
      "reason": "Held deliberately: the CI lint job type-checks services/ai_control_plane/src on this pin, and a mypy upgrade can add or reclassify errors. Rerun the check locally on the candidate version before any bump.",
      "review_by": "2027-02-04"
    }
  ],
  "manual_only_env_pins": [
    "FRAPPE_COMMIT",
    "ERPNEXT_COMMIT",
    "MARIADB_IMAGE",
    "REDIS_IMAGE",
    "FRAPPE_BENCH_IMAGE",
    "PLAYWRIGHT_IMAGE"
  ],
  "manual_review_notes": [
    {
      "name": "playwright_npm_versus_image_coherence",
      "note": "The @playwright/test npm pin in tests/e2e/package.json and the PLAYWRIGHT_IMAGE digest in development/.env.example are maintained independently, and no gate compares them. When Dependabot proposes an npm bump, confirm by hand that the pinned image carries the matching Playwright version before merging. A scripted comparator was rejected because a hand-maintained sibling version string is itself a drift surface."
    }
  ],
  "manual_only_doc_phrases": [
    "Do not auto-merge dependency PRs.",
    "Frappe/ERPNext commit or image digest",
    "site migration",
    "service integration tests",
    "local demo seed"
  ],
  "forbidden_dependabot_directories": [
    "/development",
    "/development/frappe-bench",
    "/infra/compose",
    "/"
  ],
  "root_directory_allowed_ecosystems": [
    "github-actions"
  ]
}
