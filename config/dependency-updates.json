{
  "schema_version": 1,
  "dependabot_file": ".github/dependabot.yml",
  "policy_doc": "docs/workflows/dependency-updates.md",
  "required_update_entries": [
    {
      "package_ecosystem": "github-actions",
      "directory": "/",
      "interval": "monthly",
      "labels": [
        "dependency",
        "ci"
      ],
      "open_pull_requests_limit": 3
    },
    {
      "package_ecosystem": "pip",
      "directory": "/services/ai_control_plane",
      "interval": "monthly",
      "labels": [
        "dependency",
        "ai-control-plane"
      ],
      "open_pull_requests_limit": 3
    },
    {
      "package_ecosystem": "pip",
      "directory": "/apps/ai_erp_core",
      "interval": "monthly",
      "labels": [
        "dependency",
        "erp-safety"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "pip",
      "directory": "/apps/ai_erp_service",
      "interval": "monthly",
      "labels": [
        "dependency",
        "erp-safety"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "docker",
      "directory": "/services/ai_control_plane",
      "interval": "monthly",
      "labels": [
        "dependency",
        "runtime"
      ],
      "open_pull_requests_limit": 2
    },
    {
      "package_ecosystem": "npm",
      "directory": "/tests/e2e",
      "interval": "monthly",
      "labels": [
        "dependency",
        "developer tooling"
      ],
      "open_pull_requests_limit": 2
    }
  ],
  "manual_only_env_pins": [
    "FRAPPE_COMMIT",
    "ERPNEXT_COMMIT",
    "MARIADB_IMAGE",
    "REDIS_IMAGE",
    "FRAPPE_BENCH_IMAGE",
    "PLAYWRIGHT_IMAGE"
  ],
  "manual_only_doc_phrases": [
    "Do not auto-merge dependency PRs.",
    "Frappe/ERPNext commit or image digest",
    "site migration",
    "service integration tests",
    "local demo seed"
  ],
  "forbidden_dependabot_directories": [
    "/development",
    "/development/frappe-bench",
    "/infra/compose",
    "/"
  ],
  "root_directory_allowed_ecosystems": [
    "github-actions"
  ]
}
