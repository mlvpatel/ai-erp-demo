      "forbidden_direct_actions": [
        "close work order",
        "resolve exception",
        "submit invoice",
        "post stock",
        "alter permissions"
      ]
    }
  ],
  "required_lifecycle_doc_phrases": [
    "The default policy is still draft-only",
    "Do not add a control-plane route yet.",
    "Add or update a machine-readable data-boundary manifest.",
    "The only implemented workflow is `service_closeout_summary`",
    "Do not add production model adapters, retrieval tools, new datastores, or external tool calls without an ADR."
  ],
  "required_review_doc_phrases": [
    "Every new AI workflow needs",
    "a versioned OpenAPI or event contract",
    "strict request/response models",
    "a negative test for unsupported action fields",
    "review/approval does not create unauthorized ERP transactions"
  ]
}
