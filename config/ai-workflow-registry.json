{
  "schema_version": 1,
  "description": "Machine-readable registry of approved AI-assisted ERP workflows. It prevents new AI routes or proposal types from bypassing data-boundary, contract, documentation, and test requirements.",
  "lifecycle_doc": "docs/workflows/ai-workflow-lifecycle.md",
  "review_checklist": "docs/security/ai-workflow-review.md",
  "threat_model": "docs/security/threat-model.md",
  "workflows": [
    {
      "id": "service_closeout_summary",
      "status": "implemented",
      "route": "POST /v1/proposals/service-closeout-summary",
      "proposal_type": "service_closeout_summary",
      "policy": {
        "decision": "draft_only",
        "allowed_action": "none"
      },
      "data_boundary_manifest": "config/ai-data-boundary.json",
      "openapi_contract": "contracts/openapi/ai-control-plane-v1.yaml",
      "control_plane_handler": {
        "path": "services/ai_control_plane/src/ai_erp_control_plane/app.py",
        "function": "draft_service_closeout_summary"
      },
      "control_plane_renderer": {
        "path": "services/ai_control_plane/src/ai_erp_control_plane/render.py",
        "function": "render_development_template"
      },
      "production_provider_adapter": {
        "path": "services/ai_control_plane/src/ai_erp_control_plane/openai_provider.py",
        "function": "render_openai"
      },
      "production_provider_evaluation": {
        "path": "services/ai_control_plane/src/ai_erp_control_plane/live_eval.py",
        "function": "run_live_eval",
        "runbook": "docs/runbooks/openai-live-evaluation.md"
      },
      "request_model": {
        "path": "services/ai_control_plane/src/ai_erp_control_plane/models.py",
        "class": "ServiceCloseoutSummaryRequest"
      },
      "payload_builder": {
        "path": "apps/ai_erp_service/ai_erp_service/ai_drafts.py",
        "function": "_closeout_summary_payload"
      },
      "frappe_requester": {
        "path": "apps/ai_erp_service/ai_erp_service/ai_drafts.py",
        "function": "request_closeout_summary"
      },
      "proposal_storage": {
        "path": "apps/ai_erp_core/ai_erp_core/proposals.py",
        "function": "request_service_closeout_summary"
      },
      "docs": [
        "apps/ai_erp_service/README.md",
        "docs/security/ai-workflow-review.md",
        "docs/security/data-classification.md",
        "docs/security/threat-model.md",
        "docs/workflows/service-operations.md",
        "docs/runbooks/openai-live-evaluation.md"
      ],
      "tests": [
        "services/ai_control_plane/tests/test_render.py",
        "services/ai_control_plane/tests/test_openai_provider.py",
        "services/ai_control_plane/tests/test_live_eval.py",
        "tests/contract/test_ai_control_plane_openapi.py",
        "apps/ai_erp_service/ai_erp_service/ai_erp_service/doctype/service_work_order/test_service_work_order.py"
      ],
      "proof_commands": [
        "python3 scripts/check-ai-data-boundary.py",
        "scripts/dev.sh control-plane-test",
        "scripts/dev.sh contract-test",
        "scripts/dev.sh service-test"
      ],
      "forbidden_direct_actions": [
        "submit invoice",
        "post stock",
        "change payroll",
        "alter permissions",
        "submit compliance filing"
      ]
    },
    {
