        "apps/ai_erp_service/ai_erp_service/ai_erp_service/doctype/service_work_order/test_service_work_order.py"
      ],
      "proof_commands": [
        "python3 scripts/check-ai-data-boundary.py",
        "scripts/dev.sh control-plane-test",
        "scripts/dev.sh contract-test",
        "scripts/dev.sh service-test"
