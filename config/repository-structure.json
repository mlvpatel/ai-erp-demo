{
  "required_directories": [
    ".github/ISSUE_TEMPLATE",
    ".github/workflows",
    "apps",
    "apps/ai_erp_connectors",
    "apps/ai_erp_core",
    "apps/ai_erp_distribution",
    "apps/ai_erp_manufacturing",
    "apps/ai_erp_service",
    "config",
    "contracts",
    "contracts/events",
    "contracts/openapi",
    "development",
    "docs/adr",
    "docs/architecture",
    "docs/discovery",
    "docs/product",
    "docs/runbooks",
    "docs/security",
    "docs/workflows",
    "infra/compose",
    "infra/aws/terraform",
    "infra/observability",
    "scripts",
    "services/ai_control_plane",
    "tests/contract",
    "tests/e2e",
    "tests/fixtures",
    "tests/performance"
  ],
  "required_files": [
    "README.md",
    "apps/README.md",
    "services/README.md",
    "contracts/README.md",
    "docs/architecture/system-context-and-repository-map.md",
    "docs/architecture/system-boundaries.md",
    "docs/architecture/domain-data-model.md",
    "docs/architecture/tech-stack-2026-07.md",
    "docs/discovery/discovery-design-plan.md",
    "docs/discovery/open-source-erp-scan-2026-07.md",
    "docs/discovery/service-operations-interview-guide.md",
    "docs/workflows/issue-triage.md",
    "config/industry-packs.json",
    "contracts/catalog.json"
  ],
  "allowed_root_entries": [
    ".DS_Store",
    ".git",
    ".gitattributes",
    ".gitignore",
    ".pre-commit-config.yaml",
    "BACKLOG.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md",
    "pyproject.toml",
    "uv.lock"
  ],
  "forbidden_root_directories": [
    "frontend",
    "backend",
    "client",
    "server"
  ],
  "implemented_apps": [
    {
      "path": "apps/ai_erp_core",
      "markers": [
        "pyproject.toml",
        "ai_erp_core/hooks.py",
        "ai_erp_core/ai_erp_core/doctype/ai_proposal/ai_proposal.py"
      ]
    },
    {
      "path": "apps/ai_erp_service",
      "markers": [
        "pyproject.toml",
        "ai_erp_service/hooks.py",
        "ai_erp_service/ai_erp_service/doctype/service_work_order/service_work_order.py"
      ]
    }
  ],
  "bounded_roots": {
    "apps": "custom Frappe apps and reserved industry packs only",
    "services": "AI control plane and future non-ERP support services only after ADR",
    "contracts": "versioned OpenAPI and business-event contracts only",
    "docs": "product, architecture, discovery, security, runbooks, and workflows",
    "infra": "non-secret infrastructure configuration only",
    "tests": "contract, e2e, fixture, and performance tests"
  },
  "local_only_agent_paths": [
    "CLAUDE.md",
    "AGENTS.md",
    ".agents",
    ".claude",
    ".cursor"
  ]
}
