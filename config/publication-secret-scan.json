{
  "schema_version": 1,
  "purpose": "Keep publishable AI ERP Demo sources free of real secrets, private prompts, customer data indicators, and local-only files.",
  "scanner_script": "scripts/check-publication-secrets.py",
  "scan_targets": [
    ".github",
    "BACKLOG.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md",
    "apps",
    "config",
    "contracts",
    "development",
    "docs",
    "infra",
    "scripts",
    "services",
    "tests"
  ],
  "text_file_suffixes": [
    ".cfg",
    ".css",
    ".csv",
    ".example",
    ".html",
    ".ini",
    ".js",
    ".json",
    ".md",
    ".py",
    ".sh",
    ".toml",
    ".tf",
    ".tfvars",
    ".hcl",
    ".txt",
    ".yaml",
    ".yml"
  ],
  "text_file_names": [
    ".gitattributes",
    ".gitignore",
    "Dockerfile",
    "LICENSE"
  ],
  "excluded_path_prefixes": [
    ".git/",
    ".mypy_cache/",
    ".pytest_cache/",
    ".ruff_cache/",
    ".venv/",
    "development/.venv/",
    "development/frappe-bench/",
    "dist/",
    "logs/",
    "node_modules/",
    "tests/e2e/node_modules/",
    "private/",
    "public/assets/",
    "sites/"
    ,
    ".terraform/"
  ],
  "excluded_path_suffixes": [
    ".pyc",
    ".pyd",
    ".pyo"
  ],
  "forbidden_tracked_path_prefixes": [
    ".env",
    ".env.",
    "config/owner-decisions.local.json",
    "development/.env",
    "development/frappe-bench/",
    "logs/",
    "private/",
    "public/assets/",
    "sites/"
    ,
    ".terraform/"
  ],
  "forbidden_tracked_path_suffixes": [
    ".key",
    ".pem",
    ".sql",
    ".sql.gz",
    ".dump",
    ".backup",
    "-files.tar",
    "-private-files.tar",
    ".pyd",
    ".pyo",
    ".pyc"
    ,
    ".tfstate",
    ".tfplan"
  ],
  "required_local_only_exclusions": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.sql",
    "*.sql.gz",
    "*.dump",
    "*.backup",
    "*-files.tar",
    "*-private-files.tar",
    "development/.env",
    "development/frappe-bench/",
    "config/owner-decisions.local.json",
    "sites/",
    "logs/",
    "private/",
    "public/assets/"
    ,
    ".terraform/",
    "*.tfstate",
    "*.tfstate.*",
    "*.tfvars",
    "*.tfplan"
  ],
  "secret_patterns": [
    {
      "id": "private-key-block",
      "description": "PEM or OpenSSH private key block",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "openai-api-key",
      "description": "OpenAI-style API key",
      "regex": "\\bsk-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "github-token",
      "description": "GitHub personal, OAuth, app, or refresh token",
      "regex": "\\bgh[pousr]_[A-Za-z0-9_]{20,}\\b"
    },
    {
      "id": "slack-token",
      "description": "Slack bot, app, user, refresh, or service token",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{20,}\\b"
    },
    {
      "id": "aws-access-key",
      "description": "AWS access key identifier",
      "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "google-api-key",
      "description": "Google API key",
      "regex": "\\bAIza[0-9A-Za-z_-]{20,}\\b"
    },
    {
      "id": "stripe-key",
      "description": "Stripe live or test secret key",
      "regex": "\\b(?:sk|rk)_(?:live|test)_[0-9A-Za-z]{16,}\\b"
    },
    {
      "id": "jwt-token",
      "description": "JWT-like bearer token",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
    }
  ],
  "sensitive_assignment_keys": [
    "access_key",
    "admin_password",
    "api_key",
    "client_secret",
    "db_root_password",
    "password",
    "private_key",
    "secret",
    "shared_secret",
    "token"
  ],
  "allowed_non_secret_assignment_keys": [
    "manage_master_user_password",
    "master_user_secret_kms_key_id"
  ],
  "allowed_assignment_value_patterns": [
    "^$",
    "^change-this-local-[a-z0-9-]+$",
    "^example$",
    "^example-[a-z0-9-]+$",
    "^none$",
    "^template$",
    "^todo$",
    "^<[^>]+>$",
    "^\\$\\{[A-Z0-9_]+(?::[-?][^}]*)?\\}$"
  ],
  "allowed_email_domain_suffixes": [
    "example",
    "example.org",
    "example.test",
    "localhost",
    "users.noreply.github.com"
  ],
  "policy_documents": [
    {
      "path": "docs/security/data-classification.md",
      "required_phrases": [
        "Do not commit real customer, employee, supplier, payroll, accounting, stock, or production system data.",
        "Keep `.env`, `.env.*`, `development/.env`, `development/frappe-bench/`, local sites, logs, private files, database dump and backup artifacts, and backups out of Git.",
        "Do not paste secrets or customer data into issues, pull requests, screenshots, test logs, or AI prompts.",
        "free of real names, phone numbers, emails, addresses, tax IDs, API keys, and production-like secrets"
      ]
    },
    {
      "path": "docs/runbooks/github-publication.md",
      "required_phrases": [
        "API keys, model keys, customer data, or private prompts",
        "python3 scripts/check-publication-secrets.py"
      ]
    },
    {
      "path": "docs/workflows/quality-gates.md",
      "required_phrases": [
        "publication secret and sensitive-data scan"
      ]
    }
  ]
}
