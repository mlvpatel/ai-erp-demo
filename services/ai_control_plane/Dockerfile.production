ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-compile .

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}

LABEL org.opencontainers.image.title="AI ERP control plane" \
      org.opencontainers.image.source="https://github.com/mlvpatel/ai-erp-demo" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/nonexistent

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid appuser --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin appuser
COPY --from=builder --chown=10001:10001 /opt/venv /opt/venv

WORKDIR /app
EXPOSE 8090
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/opt/venv/bin/python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8090/healthz', timeout=3)"]
CMD ["uvicorn", "ai_erp_control_plane.app:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
